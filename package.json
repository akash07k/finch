{
  "name": "finch",
  "version": "0.1.2",
  "description": "Hear your browser — short audio cues for tabs, downloads, bookmarks, and navigation. A songbird for your browsing experience.",
  "author": "Akash Kakkar (https://github.com/akash07k/)",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/akash07k/finch",
  "repository": {
    "type": "git",
    "url": "https://github.com/akash07k/finch.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "scripts": {
    "setup": "pnpm install --ignore-scripts && pnpm build:logger && pnpm --filter finch-extension exec wxt prepare",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "build:logger": "pnpm --filter @finch/logger build",
    "build:log-server": "pnpm --filter @finch/log-server build",
    "log-server": "pnpm build:log-server && node packages/log-server/dist/bin.js",
    "log-server:dev": "pnpm exec tsx packages/log-server/src/bin.ts",
    "release": "pnpm --filter finch-extension release",
    "release:dry": "pnpm --filter finch-extension release:dry",
    "release:push": "pnpm --filter finch-extension release:push",
    "do-release": "pnpm --filter finch-extension do-release",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/types": "^21.0.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lefthook": "^2.1.8",
    "lint-staged": "^17.0.5",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7",
    "ws": "^8.21.0"
  }
}
